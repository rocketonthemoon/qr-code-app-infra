# Local .terraform directories (contains downloaded provider plugins and modules)
**/.terraform/*

# .tfstate files (contain sensitive infrastructure data and credentials)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs generated by Terraform
crash.log
crash.*.log

# Exclude all .tfvars files as they likely contain sensitive values / environment secrets
*.tfvars
*.tfvars.json

# Ignore override files as they are meant for local customization
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example / template tfvars files so users know what inputs to provide
!example.tfvars
!example.tfvars.json
!*.example.tfvars

# CLI configuration files
.terraformrc
terraform.rc

# OS and Editor-specific metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Dependency lock file note:
# HashiCorp recommends COMMITTING `.terraform.lock.hcl` for root infrastructure repos 
# to ensure reproducible builds. If you wish to ignore it instead, uncomment the line below:
# .terraform.lock.hcl